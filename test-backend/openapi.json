  "components": {
    "schemas": {
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "enterprise",
              "standard"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "tier"
        ],
        "additionalProperties": false
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer"
          },
          "stock": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "price_cents",
          "stock"
        ],
        "additionalProperties": false
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "customer_id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "paid",
              "failed"
            ]
          },
          "total_cents": {
            "type": "integer"
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "customer_id",
          "product_id",
          "status",
          "total_cents",
          "error"
        ],
        "additionalProperties": false
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "customer_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          },
          "subject": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "id",
          "customer_id",
          "status",
          "subject",
          "order_id",
          "priority"
        ],
        "additionalProperties": false
      },
      "Incident": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "resolved"
            ]
          },
          "service": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "status",
          "service",
          "title",
          "started_at"
        ],
        "additionalProperties": false
      },
      "CheckoutMetrics": {
        "type": "object",
        "properties": {
          "total_orders": {
            "type": "integer"
          },
          "failed_orders": {
            "type": "integer"
          },
          "order_error_rate_percent": {
            "type": "number"
          }
        },
        "required": [
          "total_orders",
          "failed_orders",
          "order_error_rate_percent"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
