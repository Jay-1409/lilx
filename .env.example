# Start the sample backend with: node test-backend/server.js
LILX_BACKEND_URL="http://127.0.0.1:9000"
LILX_OPENAPI_URL="http://127.0.0.1:9000/openapi.json"
LILX_ALLOWED_OPERATIONS="*"
LILX_BACKEND_AUTHORIZATION=""
LILX_OPENAPI_AUTHORIZATION=""
LILX_API_KEY=""

# Gemini: set your key. Ollama: use ollama and qwen3.5:4b below; no key needed.
LILX_AI_PROVIDER="gemini"
LILX_MODEL="gemma-4-26b-a4b-it"
GEMINI_API_KEY=""
LILX_OLLAMA_URL="http://127.0.0.1:11434"
LILX_MODEL_TIMEOUT_SECONDS="600"
LILX_WORKERS="10"
LILX_LOG_DIR="logs"
LILX_LISTEN_ADDR="127.0.0.1:8080"
